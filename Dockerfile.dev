FROM ruby:3.3.6-bookworm

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential libpq-dev curl git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /rails

ENV RAILS_RUNTIMES_PATH=/workspace/rails-runtimes
ENV BUNDLE_PATH=/usr/local/bundle

COPY rails-runtimes /workspace/rails-runtimes
COPY rails-runtimes-host/Gemfile rails-runtimes-host/Gemfile.lock* ./
# Evaluate Gemfile path via RAILS_RUNTIMES_PATH already set above.
RUN bundle config set --local without 'test' && \
    bundle install

COPY rails-runtimes-host .

RUN chmod +x bin/docker-entrypoint bin/rails bin/rake 2>/dev/null || true
RUN mkdir -p tmp/pids log

EXPOSE 3000
ENTRYPOINT ["./bin/docker-entrypoint"]
CMD ["./bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
